{
  "name": "ai-rankers-dashboard",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev --name init",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "node --env-file=.env.local --import tsx prisma/seed.ts"
  },
  "dependencies": {
    "@ai-rankers/core": "workspace:*",
    "@ai-rankers/db": "workspace:*",
    "@neon/auth": "^0.8.2",
    "@neon/config": "^1.10.1",
    "@neon/env": "^1.6.9",
    "@neondatabase/serverless": "^1.0.2",
    "@prisma/adapter-neon": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.9",
    "lucide-react": "^0.511.0",
    "next": "16.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.3",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
