# Runtime database connection. Use the pooled Neon connection for Vercel functions.
DATABASE_URL=

# Direct Neon connection used by Prisma CLI migrations and status checks.
DIRECT_URL=

# Neon Auth server URL used by the Next.js auth middleware and session helpers.
NEON_AUTH_BASE_URL=

# Strong private secret for signing/authentication cookies. Never commit a value.
NEON_AUTH_COOKIE_SECRET=

# Set to true in a non-production environment to verify fail-closed access behavior.
REQUIRE_AUTH=false

# Vercel supplies NODE_ENV automatically. Do not commit production secrets here.
